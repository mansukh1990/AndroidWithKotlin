<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Task Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/recImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_truck_upload"
            app:shapeAppearanceOverlay="@style/roundedImageViewRounded" />

        <!-- Edit & Delete Action Buttons (Top Right) -->
        <LinearLayout
            android:id="@+id/actionsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/recEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Edit Task"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_baseline_edit_24"
                app:tint="@color/lavender" />

            <ImageView
                android:id="@+id/recDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Delete Task"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_baseline_delete_24"
                app:tint="@color/red" />
        </LinearLayout>

        <!-- Task Priority Badge (Bottom Right) -->
        <TextView
            android:id="@+id/recPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/actionsLayout"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_input_border"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Priority"
            android:textColor="@color/lavender"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Task Title -->
        <TextView
            android:id="@+id/recTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/recImage"
            android:layout_toStartOf="@id/actionsLayout"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Title"
            android:textColor="@color/lavender"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Task Description -->
        <TextView
            android:id="@+id/recDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/recTitle"
            android:layout_toEndOf="@id/recImage"
            android:layout_toStartOf="@id/recPriority"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Description"
            android:textColor="#666666"
            android:textSize="14sp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>